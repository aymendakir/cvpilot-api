# Local setup. For deployment use APP_ENV=production and HTTPS URLs.
APP_ENV=local
APP_DEBUG=false
# Match NEXT_PUBLIC_BACKEND_URL in the frontend .env (without /api).
APP_URL=http://localhost:8000
# Generate once with: php artisan key:generate
APP_KEY=
FRONTEND_URL=http://localhost:5173
# Optional second allowed frontend origin; leave empty if not needed.
FRONTEND_URL_LOCAL=

DB_CONNECTION=mysql
# Docker Compose: set DB_HOST=db and APP_URL=http://localhost:8080.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cvpilot
DB_USERNAME=cvpilot
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Local HTTP sessions. For cross-site HTTPS use true and none.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
# Local work keeps sessions and cache on disk. Production (no persistent disk) uses database for both,
# LOG_CHANNEL=stderr and, behind the platform's TLS proxy, TRUSTED_PROXIES=* (see docs/DEPLOYMENT.md).
SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single
# warning (default) or info: info adds one content-free `ats.analysis` line per ATS analysis.
LOG_LEVEL=warning
TRUSTED_PROXIES=
# Production answers only these host names (comma list); empty = the host of APP_URL (API-B).
TRUSTED_HOSTS=
# Single-container hosts without cron: RUN_SCHEDULER=true runs the hourly retention job next to Apache.
RUN_SCHEDULER=false
# Seconds per poppler call when the ATS checker reads a PDF (poppler-utils is required).
ATS_POPPLER_TIMEOUT=10
# Anonymous ATS check and file reading (API-A, docs/DEPLOYMENT.md section 10). Without a Turnstile secret the
# public routes are open in local/testing and answer 503 elsewhere. The marketing site's origin is SITE_URL.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
TRUST_CF_CONNECTING_IP=false
# Public site address (also the marketing site's CORS origin) and support details.
SITE_URL=
SUPPORT_EMAIL=

# Optional fallback until SMTP is saved in Dashboard > Settings > Email.
# Gmail: smtp.gmail.com, 587, tls, full email + Google App Password.
# Brevo: smtp-relay.brevo.com, 587 (or 2525), tls; use its SMTP Login + SMTP key.
# MAIL_FROM_ADDRESS must be a verified sender, never the technical @smtp-brevo.com login.
# Outlook/Microsoft OAuth is configured in the dashboard.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CVPilotAI

ADMIN_NAME=CVPilotAdmin
ADMIN_EMAIL=
ADMIN_PASSWORD=
